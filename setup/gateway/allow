#!/bin/sh
# Adds domains to the dev VM's allowlist and reloads Squid. Installed in /usr/local/bin.
# From Windows:
#   ssh agent-gateway allow docs.python.org     that host only
#   ssh agent-gateway allow .python.org         the domain and all its subdomains
set -eu

LIST=/etc/squid/allowlist.txt

[ $# -gt 0 ] || { echo "usage: allow DOMAIN..." >&2; exit 2; }

backup=$(mktemp)
cp "$LIST" "$backup"
trap 'rm -f "$backup"' EXIT

for arg in "$@"; do
    domain=$(echo "$arg" | tr '[:upper:]' '[:lower:]')
    echo "$domain" | grep -Eq '^\.?([a-z0-9-]+\.)+[a-z]{2,}$' || { cat "$backup" > "$LIST"; echo "not a domain: $arg (nothing was added)" >&2; exit 2; }
    if grep -qxF "$domain" "$LIST"; then
        echo "already allowed: $domain"
    else
        echo "$domain" >> "$LIST"
        echo "allowed: $domain"
    fi
done

if ! squid -k parse > /dev/null 2>&1; then
    # Put the list back: left in place, it would stop Squid from starting at the next reboot.
    cat "$backup" > "$LIST"
    echo "Squid rejected the list, so nothing was added; details: squid -k parse" >&2
    exit 1
fi
squid -k reconfigure
